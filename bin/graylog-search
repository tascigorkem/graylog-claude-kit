#!/bin/sh
# graylog-search: command-line entry point.
# The implementation is the Python script bundled with the Claude Code skill, so the CLI and the
# skill always run the same code. Looks next to this file first (running from the repo), then in
# the installed skill.
here="$(cd "$(dirname "$0")" && pwd)"
for script in \
  "$here/../skill/graylog/scripts/graylog_search.py" \
  "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/skills/graylog/scripts/graylog_search.py"; do
  if [ -f "$script" ]; then
    exec python3 "$script" "$@"
  fi
done
echo "graylog-search: graylog_search.py not found. Install the skill (see README.md)." >&2
exit 1
